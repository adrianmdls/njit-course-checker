# Choose one or two distinct six-digit Banner term strings. Compose also
# uses these terms for the search dropdown. Replace [] before starting.
# Example CHECKER_TERMS='["202690","202710"]'
CHECKER_TERMS=[]
# Minimum seconds from the end of a Banner request to the next start (at least 5).
BANNER_REQUEST_DELAY=5

# Set separate passwords for MariaDB root and the application's database user.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Local browser origin must match exactly. localhost and 127.0.0.1 differ.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
API_SCHEME=http
# Generate with openssl rand -hex 32 and keep it stable across restarts.
SESSION_SECRET=
# Generate a separate token with openssl rand -hex 32. Compose shares it
# between the checker and backend.
CHECKER_API_TOKEN=
# Backend base URL without /api. The Compose default is for local HTTP.
# In production or on a separate VM, use the reachable HTTPS proxy URL.
CHECKER_API_URL=http://backend:3000
# Production uses APP_ENV=production, an HTTPS APP_ORIGIN, and API_SCHEME=https.
# API_SCHEME sets the forwarded protocol. Terminate real TLS at a trusted
# proxy in front of the localhost-only Nginx port.
