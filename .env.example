# Required: explicitly choose one or two Banner term strings. No term discovery.
# Example: CHECKER_TERMS='["202690","202710"]'
CHECKER_TERMS=[]
# Minimum pause after each Banner response/failure before the next request (>=5).
BANNER_REQUEST_DELAY=5

DB_ROOT_PASSWORD=
DB_PASSWORD=

# Local browser URL must match exactly (localhost and 127.0.0.1 differ).
APP_ENV=development
APP_ORIGIN=http://localhost:8080
API_SCHEME=http
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Separate machine credential; generate with: openssl rand -hex 32
CHECKER_API_TOKEN=
# Checker base URL inside Compose; on a separate VM use the backend's HTTPS origin.
CHECKER_API_URL=http://backend:3000
# Production: APP_ENV=production, APP_ORIGIN=https://your-domain, API_SCHEME=https.
# HTTPS must terminate at a trusted proxy in front of the localhost-only Nginx port.
