CHECK_INTERVAL=600
DISCORD_WEBHOOK_URL=

DB_ROOT_PASSWORD=
DB_PASSWORD=

# Local browser URL must match exactly (localhost and 127.0.0.1 differ).
APP_ENV=development
APP_ORIGIN=http://localhost:8080
API_SCHEME=http
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Separate machine credential; generate with: openssl rand -hex 32
CHECKER_API_TOKEN=
# Production: APP_ENV=production, APP_ORIGIN=https://your-domain, API_SCHEME=https.
# HTTPS must terminate at a trusted proxy in front of the localhost-only Nginx port.
